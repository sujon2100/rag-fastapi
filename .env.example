PINECONE_API_KEY=your_key_here
OLLAMA_BASE_URL=http://localhost:11434
PINECONE_INDEX=rag-demo-st
# empty = default namespace (what the deployed service uses); eval runs use eval-v1
PINECONE_NAMESPACE=
# agent behavior (defaults shown; see README "What the eval found")
AGENT_FORCE_SEARCH=1
AGENT_GROUNDED_PROMPT=1
AGENT_NO_CONTEXT_REFUSAL=1
AGENT_MAX_TOKENS=1024
SEARCH_MIN_SCORE=0.54
